{
  "name": "procedural-platformer",
  "private": true,
  "version": "1.0.0",
  "description": "A procedurally generated 2D platformer game",
  "main": "js/main.js",
  "type": "module",
  "scripts": {
    "start": "bunx serve -l tcp://127.0.0.1:3000 .",
    "test": "bun test tests/unit tests/integration",
    "test:e2e": "bun run build && bun test tests/e2e",
    "test:all": "bun run build && bun test",
    "test:watch": "bun test --watch tests/unit tests/integration",
    "test:coverage": "bun test --coverage tests/unit tests/integration",
    "lint": "bunx eslint js/ tests/ scripts/",
    "mono": "bun scripts/monotonicity-check.js",
    "format": "bunx prettier --write js/ css/ index.html",
    "build": "bun run verify && bun build --target=browser --format=iife --outfile=dist/bundle.js js/main.js",
    "verify": "bun scripts/verify-assets.js"
  },
  "keywords": [
    "game",
    "platformer",
    "procedural"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "serve": "^14.2.6"
  }
}
