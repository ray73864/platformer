node_modules/
# dist/ (not dist/) so the negation below can re-include the runtime bundle:
# index.html loads dist/bundle.js as a classic script — double-clicking the
# page must work on a fresh checkout, so the bundle ships with the source.
dist/*
!dist/bundle.js
assets/*.zip
assets/*.psd
assets/*.ai
assets/*.eps
# Owner-supplied overrides stay local (see assets/dropin/README.txt).
assets/dropin/*
!assets/dropin/README.txt
.DS_Store
